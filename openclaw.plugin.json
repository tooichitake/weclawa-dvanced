{
  "id": "clawbnb-hub",
  "name": "ClawBNB Hub",
  "description": "ClawBNB Hub Weixin channel, rental relay, proxy provider, and rental-session safety hooks.",
  "channels": ["clawbnb-weixin"],
  "channelConfigs": {
    "clawbnb-weixin": {
      "schema": {
        "type": "object",
        "additionalProperties": true
      },
      "label": "clawbnb-weixin",
      "description": "ClawBNB Hub Weixin channel configuration."
    }
  },
  "providers": ["molt-proxy"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "hostModelControl": {
        "type": "string",
        "enum": ["inherit", "proxy"]
      },
      "apiKey": {
        "type": "string"
      },
      "relayUrl": {
        "type": "string"
      },
      "proxyBaseUrl": {
        "type": "string"
      },
      "proxyModelId": {
        "type": "string"
      },
      "skillTags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "capabilityLevel": {
        "type": "string",
        "enum": ["chat_only"]
      },
      "version": {
        "type": "string"
      },
      "heartbeatIntervalMs": {
        "type": "integer",
        "minimum": 1000
      },
      "reconnectBaseDelayMs": {
        "type": "integer",
        "minimum": 100
      },
      "reconnectMaxDelayMs": {
        "type": "integer",
        "minimum": 100
      },
      "runTimeoutMs": {
        "type": "integer",
        "minimum": 1000
      },
      "tempRoot": {
        "type": "string"
      },
      "toolRefusalText": {
        "type": "string"
      },
      "extraSystemPrompt": {
        "type": "string"
      },
      "agent": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "backend": {
            "type": "string",
            "enum": ["cli", "pi-ai"]
          },
          "cli": {
            "type": "string",
            "enum": ["claude", "codex"]
          },
          "claude": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "useAgentSdk": { "type": "boolean" },
              "binaryPath": { "type": "string" },
              "model": { "type": "string" },
              "extraSystemPrompt": { "type": "string" },
              "anthropicApiKey": { "type": "string" }
            }
          },
          "codex": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "binaryPath": { "type": "string" },
              "openaiApiKey": { "type": "string" }
            }
          },
          "sessionTimeoutMs": {
            "type": "integer",
            "minimum": 5000
          },
          "maxOutboundFiles": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
